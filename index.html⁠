<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AMIR FF SHOP</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
        body { background-color: #0f1015; color: #ffffff; padding: 15px; }
        .card { background: linear-gradient(135deg, #4f46e5, #7c3aed); border-radius: 16px; padding: 20px; text-align: center; margin-bottom: 20px; }
        .balance-title { font-size: 14px; opacity: 0.8; margin-bottom: 5px; }
        .balance-amount { font-size: 32px; font-weight: bold; margin-bottom: 15px; }
        .btn-group { display: flex; gap: 10px; }
        .btn { flex: 1; padding: 10px; border: none; border-radius: 10px; background: rgba(255,255,255,0.2); color: #fff; font-weight: bold; cursor: pointer; }
        .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
        .game-card { background: #1a1c23; border-radius: 14px; padding: 15px; text-align: center; border: 1px solid #2d313e; }
        .game-card h3 { font-size: 14px; margin-top: 8px; color: #fff; }
        .badge { display: inline-block; background: #4f46e5; font-size: 10px; padding: 2px 6px; border-radius: 4px; font-weight: bold; }
    </style>
</head>
<body>
    <div class="card">
        <div class="balance-title">Баланс</div>
        <div class="balance-amount">0.0 сомонӣ</div>
        <div class="btn-group">
            <button class="btn">💳 Пур кардан</button>
            <button class="btn">💬 Дастгирӣ</button>
        </div>
    </div>

    <h2 style="font-size: 16px; margin-bottom: 12px;">Бозиҳо:</h2>
    <div class="grid">
        <div class="game-card">
            <span class="badge">GLOBAL</span>
            <h3>FREE FIRE</h3>
        </div>
        <div class="game-card">
            <span class="badge">GLOBAL</span>
            <h3>PUBG MOBILE</h3>
        </div>
        <div class="game-card">
            <span class="badge">GLOBAL</span>
            <h3>STANDOFF 2</h3>
        </div>
        <div class="game-card">
            <span class="badge">GLOBAL</span>
            <h3>MOBILE LEGENDS</h3>
        </div>
    </div>

    <script>
        const tg = window.Telegram.WebApp;
        tg.expand();
    </script>
</body>
</html>
